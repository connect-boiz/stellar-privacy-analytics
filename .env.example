# Database Configuration
DATABASE_URL=postgresql://stellar:password@localhost:5432/stellar_db
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────────────────────
# Secrets (WS2 — issue #413)
# These are REQUIRED in production. The boot-time audit (config/env.ts)
# refuses to start a production process with any of these missing or still
# set to a known development default. Generate strong, unique, random values.
# NEVER commit a real .env.
# ──────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-key
API_KEY_SECRET=your-api-key-hmac-secret
STORAGE_MASTER_KEY=a-32-byte-utf8-string-random-value
AUDIT_SIGNATURE_KEY=your-audit-hmac-secret
# Public rate-limit bypass is REMOVED (WS5). This is only an internal,
# instance-internal value used where a validated override is permitted;
# it is never a way for unauthenticated callers to bypass the limiter.
RATE_LIMIT_EMERGENCY_BYPASS_KEY=
# HSM is the source of truth for master keys (WS2). Set these in production.
# When HSM_ENDPOINT is set, the master key is generated/persisted via the
# HSM and never held in app memory. Leave empty only for local dev.
HSM_ENDPOINT=
HSM_API_KEY=
HSM_API_SECRET=
HSM_CLIENT_ID=

# Encryption Keys (Generate these for production)
ENCRYPTION_KEY=your-256-bit-encryption-key-here
HOMOMORPHIC_KEY=your-homomorphic-encryption-key

# Privacy Configuration
DEFAULT_PRIVACY_LEVEL=high
DATA_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=90
MAX_DATA_SIZE_MB=1000
ALLOW_DATA_EXPORT=true

# API Configuration
API_PORT=3001
API_HOST=localhost
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend Configuration
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# Analytics Configuration
ANALYTICS_BATCH_SIZE=100
ANALYTICS_MAX_CONCURRENT=10
DIFFERENTIAL_PRIVACY_EPSILON=1.0
MIN_PARTICIPANTS_FOR_ANALYSIS=5

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret
CSRF_SECRET=your-csrf-secret

# Monitoring & Logging
LOG_LEVEL=info
ENABLE_METRICS=true
METRICS_PORT=9090
SENTRY_DSN=

# Development
NODE_ENV=development
DEBUG=stellar:*
HOT_RELOAD=true

# Sandbox Environment Configuration
SANDBOX_ENABLED=false
STELLAR_ENVIRONMENT=mainnet

# Stellar Network URLs
STELLAR_MAINNET_RPC_URL=https://soroban-mainnet.stellar.org
STELLAR_MAINNET_PASSPHRASE=Public Global Stellar Network ; September 2015
STELLAR_MAINNET_HORIZON_URL=https://horizon.stellar.org

STELLAR_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_TESTNET_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org

STELLAR_SANDBOX_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_SANDBOX_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_SANDBOX_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban Contract Deployer Keys (set these in CI/production; never commit .env)
ADMIN_SECRET_KEY=
USER1_SECRET_KEY=
USER2_SECRET_KEY=

# Splunk / External Monitoring (optional)
SPLUNK_PASSWORD=
